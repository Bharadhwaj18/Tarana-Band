# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Configuration
RESEND_API_KEY=your_resend_api_key
# Sender on a domain verified in Resend. Without it, emails only reach the Resend account owner.
RESEND_FROM_EMAIL="Tarana Band <orders@yourdomain.com>"
NEXT_PUBLIC_CONTACT_EMAIL=band@tarana.com

# Razorpay (merch payments). Dashboard -> Account & Settings -> API keys.
# rzp_test_ keys are for testing, rzp_live_ keys once you're live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
# The secret you type when adding the webhook (Account & Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google Analytics
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Admin Email (where contact form submissions go)
ADMIN_EMAIL=admin@tarana.com

# Secret for the private reviewer link /api/review?key=... (shows the hidden merch shop to a payment gateway reviewer)
REVIEW_ACCESS_KEY=pick_a_long_random_string

# Link to Rigly (the band's Setlist Manager), which owns merch stock and records online sales
# RIGLY_URL is Rigly's address; STORE_API_KEY is a shared secret, the same value in Rigly's environment
RIGLY_URL=https://tarana-setlist-manager.vercel.app
STORE_API_KEY=pick_a_long_random_string
